@startuml
title Casos de uso - Control de ingreso y retiro

left to right direction

skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam shadowing false
skinparam usecase {
  BackgroundColor #F8FBFD
  BorderColor #1E88C8
  ArrowColor #0B2A44
}

actor "Usuario comunidad\nuniversitaria" as Usuario
actor "Guardia" as Guardia
actor "Sistema de correo" as Correo

rectangle "Sistema UBBike" {
  package "Operacion con QR" {
    usecase "Generar código QR" as UC01
    usecase "Validar código QR" as UC02
    usecase "Confirmar ingreso" as UC03
    usecase "Confirmar retiro" as UC04
    usecase "Rechazar movimiento" as UC05
    usecase "Agregar comentario" as UC06
  }

  package "Operacion manual" {
    usecase "Buscar usuario por\nRUT o correo" as UC07
    usecase "Registrar ingreso\nmanual" as UC08
    usecase "Registrar retiro\nmanual" as UC09
    usecase "Registrar usuario\nparcial" as UC10
  }

  package "Trazabilidad" {
    usecase "Consultar historial\npropio" as UC11
    usecase "Consultar historial\noperativo" as UC12
    usecase "Enviar correo de\nmovimiento" as UC13
  }
}

Usuario --> UC01
Usuario --> UC11

Guardia --> UC02
Guardia --> UC03
Guardia --> UC04
Guardia --> UC05
Guardia --> UC06
Guardia --> UC07
Guardia --> UC08
Guardia --> UC09
Guardia --> UC10
Guardia --> UC12

UC13 -- Correo

UC03 ..> UC02 : <<include>>
UC04 ..> UC02 : <<include>>
UC05 ..> UC02 : <<extend>>
UC06 ..> UC03 : <<extend>>
UC06 ..> UC04 : <<extend>>
UC08 ..> UC07 : <<include>>
UC09 ..> UC07 : <<include>>
UC10 ..> UC08 : <<extend>>
UC08 ..> UC13 : <<include>>
UC09 ..> UC13 : <<include>>

@enduml
